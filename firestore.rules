rules_version = '2';

// The web app never reads or writes Firestore from the browser: every read and
// write goes through its own API routes, which use the Admin SDK with a
// service account (lib/firebase-admin.ts) and decide there who may do what.
// The Admin SDK is not subject to these rules, so the database can be closed
// to everything else. The browser uses Firebase only to sign in with Google.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
