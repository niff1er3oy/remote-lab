# Copy this file to .env and fill in the values. .env is never committed.
# The server reads it once at start: restart after changing anything here.

# ── Firebase Admin (server side: sessions, Firestore) ──────────────────────────
# From the Firebase console: Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the \n sequences exactly as they are in the downloaded key.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ── Firebase web app (browser side: Google sign-in) ────────────────────────────
# From the Firebase console: Project settings > Your apps > Web app.
# These are built into the pages, so they are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admins ─────────────────────────────────────────────────────────────────────
# Google accounts that may open /admin, separated by commas. Empty means nobody.
ADMIN_EMAILS=you@example.com

# ── Lab rig (the Python scripts that drive the coils, the solenoid and the supply) ──
# Folder on the lab machine that holds coil_1.py, coil_2.py, coil_3.py, coil_b.py,
# sole.py, sole_b.py, psu_on.py and psu_off.py. Scripts are run from this folder.
RIG_SCRIPT_DIR=/home/admin/Documents
# The Python that runs them. Leave empty to use <RIG_SCRIPT_DIR>/venv/bin/python.
RIG_PYTHON=

# ── Cameras (MediaMTX) ─────────────────────────────────────────────────────────
# One address per camera, without a trailing slash. cam1 is the main camera,
# cam2 the second camera for the solenoid, cam3 the second camera for the coils.
cam1=http://camera-host:8889/camera1
cam2=http://camera-host:8889/camera2
cam3=http://camera-host:8889/camera3
CAM_USER=admin
CAM_PASSWORD=

# ── AI teaching assistant (Typhoon) ────────────────────────────────────────────
TYPHOON_API_KEY=

# ── Server (optional) ──────────────────────────────────────────────────────────
# PORT=3000
# Address to listen on. Default: localhost in development, 0.0.0.0 in production.
# LISTEN_HOST=0.0.0.0

# ── Deployment (docker-compose only) ───────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
